<!-- Use the .NET SDK build rules. Rider and dotnet build read this project through MSBuild.
  C# source files under this folder are included automatically unless excluded below.
  PropertyGroup defines settings; ItemGroup lists files or dependencies; Target defines build steps.
  $(Name) reads a build property. Condition makes an element apply only when its expression is true. -->
<Project Sdk="Microsoft.NET.Sdk">
  <!-- Load optional machine-specific paths and switches before applying the defaults below. -->
  <Import Project="local.build.props" Condition="Exists('local.build.props')" />

  <PropertyGroup>
    <!-- Frameworks used by the build. The configuration selects the matching framework below:
        Mono/CrossCompat use .NET Standard 2.1; IL2CPP uses .NET 6. -->
    <TargetFrameworks>netstandard2.1;net6.0</TargetFrameworks>
    <TargetFramework Condition="'$(Configuration)' != 'Il2cpp'">netstandard2.1</TargetFramework>
    <TargetFramework Condition="'$(Configuration)' == 'Il2cpp'">net6.0</TargetFramework>
    <!-- Enable compiler warnings for possible null mistakes; implicit usings add common System imports. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Default namespace for tooling and generated resources; explicit C# namespaces are separate. -->
    <RootNamespace>S1API_NetWorthGUI</RootNamespace>
    <!-- Project version and DLL filename. Update Version to change the version suffix in AssemblyName.
        MelonLoader reads its displayed mod version from Constants.ModVersion in the C# code. -->
    <Version>0.1.6</Version>
    
    <AssemblyName>$(RootNamespace)_v$(Version)</AssemblyName>
    <!-- Use the installed compiler's latest supported C# syntax; declare English as the neutral resource language. -->
    <LangVersion>latest</LangVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
    <!-- Build choices shown in Rider or selected with dotnet build -c. AnyCPU avoids a fixed CPU target. -->
    <Configurations>CrossCompat;Mono;Il2cpp</Configurations>
    <Platforms>AnyCPU</Platforms>
    <!-- Allow C# unsafe code when required by interop with native code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Do not copy every NuGet dependency into the output folder; the game/loader supplies runtime libraries. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Keep local game references out of SDK items, publishing, and NuGet packages. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);.local-references/**</DefaultItemExcludes>
    <!-- Optional switches default to false only when not already supplied (for example in local.build.props).
        Deployment copies the built DLL to Mods. The two UseLocal switches replace NuGet dependencies with local DLLs. -->
    <AutomateLocalDeployment Condition="'$(AutomateLocalDeployment)' == ''">false</AutomateLocalDeployment>
    <UseLocalS1APIForked Condition="'$(UseLocalS1APIForked)' == ''">false</UseLocalS1APIForked>
    <UseLocalMelonLoaderReferences Condition="'$(UseLocalMelonLoaderReferences)' == ''">false</UseLocalMelonLoaderReferences>

    <!-- Defaults for a sibling S1API source checkout and its compiled DLL. These matter when UseLocalS1APIForked is true.
        Select its build configuration and framework to match this mod's runtime. -->
    <LocalS1APIRoot Condition="'$(LocalS1APIRoot)' == ''">..\S1API</LocalS1APIRoot>
    <LocalS1APIBuildConfiguration Condition="'$(LocalS1APIBuildConfiguration)' == '' and '$(Configuration)' == 'Il2cpp'">Il2CppMelon</LocalS1APIBuildConfiguration>
    <LocalS1APIBuildConfiguration Condition="'$(LocalS1APIBuildConfiguration)' == ''">MonoMelon</LocalS1APIBuildConfiguration>
    <LocalS1APITargetFramework Condition="'$(LocalS1APITargetFramework)' == '' and '$(Configuration)' == 'Il2cpp'">net6.0</LocalS1APITargetFramework>
    <LocalS1APITargetFramework Condition="'$(LocalS1APITargetFramework)' == ''">netstandard2.1</LocalS1APITargetFramework>
    <LocalS1APIForkedPath Condition="'$(LocalS1APIForkedPath)' == ''">$(LocalS1APIRoot)\S1API\bin\$(LocalS1APIBuildConfiguration)\$(LocalS1APITargetFramework)\S1API.dll</LocalS1APIForkedPath>

    <!-- Derive reference folders from local game install paths unless explicit reference paths were supplied.
        Mono uses managed game DLLs; IL2CPP uses wrappers generated by MelonLoader. -->
    <MonoAssembliesPath Condition="'$(MonoAssembliesPath)' == '' and '$(LocalMonoDeploymentPath)' != ''">$(LocalMonoDeploymentPath)\Schedule I_Data\Managed</MonoAssembliesPath>
    <Il2CppAssembliesPath Condition="'$(Il2CppAssembliesPath)' == '' and '$(LocalIl2CppDeploymentPath)' != ''">$(LocalIl2CppDeploymentPath)\MelonLoader\Il2CppAssemblies</Il2CppAssembliesPath>
    <MelonLoaderMonoAssembliesPath Condition="'$(MelonLoaderMonoAssembliesPath)' == '' and '$(LocalMonoDeploymentPath)' != ''">$(LocalMonoDeploymentPath)\MelonLoader\net35</MelonLoaderMonoAssembliesPath>
    <MelonLoaderAssembliesPath Condition="'$(MelonLoaderAssembliesPath)' == '' and '$(LocalIl2CppDeploymentPath)' != ''">$(LocalIl2CppDeploymentPath)\MelonLoader\net6</MelonLoaderAssembliesPath>
  </PropertyGroup>

  <!-- Standalone earnings checks are a separate executable, never mod source or content. -->
  <ItemGroup>
    <Compile Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>

  <!-- Compilation symbols select C# branches such as #if MONO or #if IL2CPP.
    CrossCompat defines MONO too, while using S1API abstractions for cross-runtime support. -->
  <PropertyGroup Condition="'$(Configuration)' == 'CrossCompat'">
    <DefineConstants>$(DefineConstants);CROSS_COMPAT;MONO</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Mono'">
    <DefineConstants>$(DefineConstants);MONO</DefineConstants>
    <AssemblyName>$(AssemblyName)_Mono</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Il2cpp'">
    <DefineConstants>$(DefineConstants);IL2CPP</DefineConstants>
    <AssemblyName>$(AssemblyName)_Il2cpp</AssemblyName>
  </PropertyGroup>

  <!-- Default dependency source: restore the S1API helper library from NuGet. -->
  <ItemGroup Condition="'$(UseLocalS1APIForked)' != 'true'">
    <PackageReference Include="S1API.Forked" Version="3.1.4" />
  </ItemGroup>

  <!-- MelonLoader provides the mod lifecycle; HarmonyX provides method patches.
    PrivateAssets prevents these dependencies flowing to projects consuming this project.
    NoWarn suppresses NU1701, the package framework compatibility warning, for MelonLoader. -->
  <ItemGroup Condition="'$(UseLocalMelonLoaderReferences)' != 'true'">
    <PackageReference Include="LavaGang.MelonLoader" Version="0.7.1" PrivateAssets="all" NoWarn="NU1701" />
    <PackageReference Include="HarmonyX" Version="2.15.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Alternative to NuGet: reference a locally compiled S1API DLL.
    HintPath locates a reference DLL; Private=false prevents copying that DLL into the build output. -->
  <ItemGroup Condition="'$(UseLocalS1APIForked)' == 'true'">
    <Reference Include="S1API.Forked">
      <HintPath>$(LocalS1APIForkedPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Unity, text/UI, and JSON libraries from the Mono install, shared by Mono and CrossCompat builds. -->
  <ItemGroup Label="CommonMonoUnityReferences" Condition="('$(Configuration)' == 'CrossCompat' or '$(Configuration)' == 'Mono') and '$(MonoAssembliesPath)' != ''">
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(MonoAssembliesPath)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(MonoAssembliesPath)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(MonoAssembliesPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(MonoAssembliesPath)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(MonoAssembliesPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(MonoAssembliesPath)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(MonoAssembliesPath)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(MonoAssembliesPath)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(MonoAssembliesPath)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIElementsModule">
      <HintPath>$(MonoAssembliesPath)\UnityEngine.UIElementsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(MonoAssembliesPath)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Direct game assembly references for the Mono-specific build. -->
  <ItemGroup Label="MonoGameReferences" Condition="'$(Configuration)' == 'Mono' and '$(MonoAssembliesPath)' != ''">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(MonoAssembliesPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(MonoAssembliesPath)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Equivalent Unity, text/UI, and JSON wrapper references for the IL2CPP-specific build. -->
  <ItemGroup Label="CommonIl2CppUnityReferences" Condition="'$(Configuration)' == 'Il2cpp' and '$(Il2CppAssembliesPath)' != ''">
    <Reference Include="Il2CppNewtonsoft.Json">
      <HintPath>$(Il2CppAssembliesPath)\Il2CppNewtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(Il2CppAssembliesPath)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(Il2CppAssembliesPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(Il2CppAssembliesPath)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(Il2CppAssembliesPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(Il2CppAssembliesPath)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(Il2CppAssembliesPath)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(Il2CppAssembliesPath)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(Il2CppAssembliesPath)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIElementsModule">
      <HintPath>$(Il2CppAssembliesPath)\UnityEngine.UIElementsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(Il2CppAssembliesPath)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- IL2CPP game wrappers and interop runtime, used to access the native game from managed C#. -->
  <ItemGroup Label="Il2CppGameReferences" Condition="'$(Configuration)' == 'Il2cpp' and '$(Il2CppAssembliesPath)' != ''">
    <!-- Generated Unity wrappers expose base types from the IL2CPP core library. -->
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(Il2CppAssembliesPath)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(Il2CppAssembliesPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(Il2CppAssembliesPath)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MelonLoaderAssembliesPath)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Local Mono MelonLoader and Harmony DLLs, used instead of their NuGet packages. -->
  <ItemGroup Condition="'$(UseLocalMelonLoaderReferences)' == 'true' and ('$(Configuration)' == 'CrossCompat' or '$(Configuration)' == 'Mono')">
    <Reference Include="0Harmony">
      <HintPath>$(MelonLoaderMonoAssembliesPath)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonLoaderMonoAssembliesPath)\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Local IL2CPP MelonLoader, Harmony, and interop DLLs, used instead of their NuGet packages. -->
  <ItemGroup Condition="'$(UseLocalMelonLoaderReferences)' == 'true' and '$(Configuration)' == 'Il2cpp'">
    <Reference Include="0Harmony">
      <HintPath>$(MelonLoaderAssembliesPath)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonLoaderAssembliesPath)\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MelonLoaderAssembliesPath)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Generate our own BuildInfo, separate from MelonLoader.BuildInfo.
       Keep its namespace aligned with Constants.cs by using RootNamespace plus .Utils.
       Generated code lives under obj; edit Version above instead of the generated file. -->
  <Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFile>
    </PropertyGroup>
    <ItemGroup>
      <_BuildInfoLines Include="// &lt;auto-generated /&gt;" />
      <_BuildInfoLines Include="namespace $(RootNamespace).Utils { internal static class BuildInfo { public const string Version = &quot;$(Version)&quot;%3B public const string ModName = &quot;$(RootNamespace)&quot;%3B } }" />
      <Compile Include="$(BuildInfoFile)" />
      <FileWrites Include="$(BuildInfoFile)" />
    </ItemGroup>
    <WriteLinesToFile File="$(BuildInfoFile)" Lines="@(_BuildInfoLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- Validation steps run before resolving references and stop the build with a useful message
    if required local files or paths have not been configured. -->
  <Target Name="ValidateLocalS1APIPath" BeforeTargets="ResolveReferences" Condition="'$(UseLocalS1APIForked)' == 'true'">
    <Error Condition="'$(LocalS1APIForkedPath)' == ''" Text="UseLocalS1APIForked is true, but LocalS1APIForkedPath is empty. Set it in local.build.props or turn UseLocalS1APIForked off." />
    <Error Condition="'$(LocalS1APIForkedPath)' != '' and !Exists('$(LocalS1APIForkedPath)')" Text="Local S1API was not found at '$(LocalS1APIForkedPath)'. Build S1API with configuration '$(LocalS1APIBuildConfiguration)', set LocalS1APIRoot/LocalS1APIForkedPath, or turn UseLocalS1APIForked off." />
  </Target>

  <Target Name="ValidateMonoPaths" BeforeTargets="ResolveReferences" Condition="('$(Configuration)' == 'Mono' or ('$(Configuration)' == 'CrossCompat' and '$(UseLocalMelonLoaderReferences)' == 'true')) and '$(MonoAssembliesPath)' == ''">
    <Error Text="Set LocalMonoDeploymentPath in local.build.props, or run .\setup.ps1, before building Mono." />
  </Target>

  <Target Name="ValidateIl2CppPaths" BeforeTargets="ResolveReferences" Condition="'$(Configuration)' == 'Il2cpp' and ('$(Il2CppAssembliesPath)' == '' or '$(MelonLoaderAssembliesPath)' == '')">
    <Error Text="Set LocalIl2CppDeploymentPath in local.build.props, or run .\setup.ps1, before building Il2cpp." />
  </Target>

  <!-- Optional deployment steps run after a successful build, only when AutomateLocalDeployment is true.
    TargetPath is the built DLL's full path; TargetFileName is its filename.
    MakeDir creates Mods if needed; Copy skips files that are already up to date.
    Each configuration copies to its matching install (CrossCompat uses the configured Mono install). -->
  <Target Name="DeployCrossCompat" AfterTargets="Build" Condition="'$(AutomateLocalDeployment)' == 'true' and '$(Configuration)' == 'CrossCompat' and '$(LocalMonoDeploymentPath)' != ''">
    <Message Text="[CrossCompat] Copying $(TargetFileName) to $(LocalMonoDeploymentPath)\Mods" Importance="high" />
    <MakeDir Directories="$(LocalMonoDeploymentPath)\Mods" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(LocalMonoDeploymentPath)\Mods" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="DeployMono" AfterTargets="Build" Condition="'$(AutomateLocalDeployment)' == 'true' and '$(Configuration)' == 'Mono' and '$(LocalMonoDeploymentPath)' != ''">
    <Message Text="[Mono] Copying $(TargetFileName) to $(LocalMonoDeploymentPath)\Mods" Importance="high" />
    <MakeDir Directories="$(LocalMonoDeploymentPath)\Mods" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(LocalMonoDeploymentPath)\Mods" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="DeployIl2Cpp" AfterTargets="Build" Condition="'$(AutomateLocalDeployment)' == 'true' and '$(Configuration)' == 'Il2cpp' and '$(LocalIl2CppDeploymentPath)' != ''">
    <Message Text="[Il2cpp] Copying $(TargetFileName) to $(LocalIl2CppDeploymentPath)\Mods" Importance="high" />
    <MakeDir Directories="$(LocalIl2CppDeploymentPath)\Mods" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(LocalIl2CppDeploymentPath)\Mods" SkipUnchangedFiles="true" />
  </Target>
</Project>
